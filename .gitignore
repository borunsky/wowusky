# build artifacts
build/
# electron-builder needs its icon in desktop/build/ — track that dir
!desktop/build/
dist/
*.egg-info/
*.whl
*.tar.gz

# python caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# editors
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# wowusky runtime data (in case someone runs from the source dir)
config.json.local
*.json.migrated
# makepkg artifacts (anchored to repo root so they don't clobber desktop/src)
/pkg/
/src/
*.pkg.tar.zst
